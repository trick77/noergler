# Instance layer: everything shared by all teams, plus the defaults a team may
# override in teams.yaml. Per-team values (inference key, webhook secret,
# projects, riptide) live in teams.yaml — see teams.example.yaml.
#
# Convention: a live line is required; a commented line is optional and shows
# its default.

# --- Required ---
# Shared Bitbucket service account. The username doubles as the @mention trigger.
BITBUCKET_URL=https://bitbucket.company.com
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=
# Base URL of the OpenAI-compatible endpoint (the SDK appends /chat/completions).
# Instance-wide: teams bring their own key, not their own gateway.
OPENAI_BASE_URL=https://litellm.company.com/v1
# Model catalog in LiteLLM's model_prices_and_context_window.json format. noergler
# looks every team's model up in it at startup for the context window, and uses its
# rates only as a cost fallback. Point this at the catalog your gateway publishes: it is
# the one that lists the gateway's own model names (ai-gateway/gpt-5.4) and is
# reachable without internet egress. Differs between intg and prod.
MODEL_CATALOG_URL=https://ai-gateway-catalog.company.com/model_prices_and_context_window.json
DATABASE_URL=postgresql://noergler:changeme@localhost:5432/noergler
# Single Jira user, read-only (fetches tickets for acceptance criteria).
JIRA_URL=https://jira.company.com
JIRA_TOKEN=

# --- Teams ---
# TEAMS_CONFIG=teams.yaml                 # path to the teams file; noergler does not start without it

# Per-team secrets referenced from teams.yaml via *_env. Names are free, this is
# the convention (slug uppercased, - -> _). One block per team.
TEAM_PLATFORM_WEBHOOK_SECRET=             # required per team: openssl rand -hex 32
TEAM_PLATFORM_OPENAI_API_KEY=             # required per team: the team's key on the gateway
# TEAM_PLATFORM_RIPTIDE_TOKEN=            # only when the team has a riptide: block
TEAM_PAYMENTS_WEBHOOK_SECRET=
TEAM_PAYMENTS_OPENAI_API_KEY=

# --- Review behavior: instance defaults, each overridable per team under review: ---
# REVIEW_AUTO_REVIEW_AUTHORS=           # comma-separated; empty = review all authors
# REVIEW_MAX_COMMENTS=25
# REVIEW_MAX_FILE_LINES=1000               # files exceeding this line count are reviewed without full file context
# REVIEW_DIFF_EXTRA_LINES_BEFORE=3      # context lines added before each diff hunk
# REVIEW_DIFF_EXTRA_LINES_AFTER=2       # context lines added after each diff hunk
# REVIEW_DIFF_MAX_EXTRA_LINES_DYNAMIC_CONTEXT=10  # how far above the context window to search for enclosing function/class definition
# REVIEW_DIFF_ALLOW_DYNAMIC_CONTEXT=true          # extend diff context to include enclosing function/class definition
# REVIEW_TICKET_COMPLIANCE_CHECK=true   # evaluate PR against Jira ticket acceptance criteria
# REVIEW_REQUIRE_AGENTS_MD=true         # skip the review (with a summary explaining why) when the repo has no AGENTS.md
# REVIEW_AGENTS_MD_WARN_TOKENS=4000     # warn in the review summary when AGENTS.md exceeds this token count (risk of context bloat)
# REVIEW_AGENTS_MD_MAX_TOKENS=7000      # skip the review when AGENTS.md exceeds this token count
# REVIEW_AGENTS_MD_CUSTOM_LINK=         # extra link in the "AGENTS.md too large" summary: [Title](URL) or a bare URL
# REVIEW_OPT_OUT_BRANCH_KEYWORD=noergloff  # if this substring is in the source branch name, skip review (empty = disabled)
# REVIEW_MAX_PR_COST_USD=5.00              # once a PR's accumulated est. cost reaches this, stop auto-reviewing it (@mention still works)

# --- Review prompts: instance only, not team-overridable ---
# REVIEW_PROMPT_TEMPLATE=prompts/review.txt
# REVIEW_MENTION_PROMPT_TEMPLATE=prompts/mention.txt

# --- Jira: instance default, overridable per team under jira: ---
# JIRA_ACCEPTANCE_CRITERIA_PREFIXES=AC,AK,Acceptance Criteria,Acceptance Criterion,Akzeptanzkriterium,Akzeptanzkriterien,DoD,Req

# --- AI model: instance defaults, each overridable per team under inference: ---
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_EFFORT=high                          # one of: minimal, low, medium, high. noergler needs a reasoning-capable model; a team whose endpoint rejects it is disabled at startup.
# OPENAI_CONTEXT_WINDOW=0                               # 0 = take max_input_tokens from the catalog entry. Set explicitly to override it when your endpoint enforces a lower cap than the catalog advertises. noergler requires a >= 1M-token window and reviews each PR in one call.

# --- Context-window trust curve (instance only) ---
# CONTEXT_WINDOW_HEADROOM_TOKENS=16000
# CONTEXT_TRUST_THRESHOLD=256000
# CONTEXT_TRUST_TAIL=0.5

# --- Server / logging (instance only) ---
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# LOG_LEVEL=INFO
# NOERGLER_ENV=dev                                      # `env` field on every log record

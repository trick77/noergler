# Secrets / per-deployment config
.env
teams.yaml

# Plans and other HTML deliverables
docs/plans/

# Build. Anchored: a bare `noergler` matches any path component of that name at
# any depth, which would silently swallow a nested one.
/backend/noergler
fakes
/bin/
coverage/

# Bytecode caches. The retired implementation's directories still sit
# untracked at the root, so these must be ignored here, not only under
# archive/.
__pycache__/
*.pyc
.pytest_cache/

# IDEs
.vscode/
.idea/
*.iml
*.swp
*~

# Agent tooling
.claude/
.agents/
.cursor/
.aider*
.codex/
.zed/
.windsurf/

# macOS
.DS_Store

# IntelliJ HTTP client: host, team secret and admin token, filled in locally (template: .example)
http/http-client.env.json

# The built SPA. dist/.gitkeep is tracked on purpose: //go:embed all:dist
# fails to compile on a missing or empty directory, so a fresh clone must
# still have one.
/backend/web/dist/*
!/backend/web/dist/.gitkeep
/ui/node_modules/

# tsc -b incremental state, regenerated on every build.
ui/tsconfig.tsbuildinfo

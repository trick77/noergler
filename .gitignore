# Secrets / per-deployment config
.env
teams.yaml

# Plans and other HTML deliverables
docs/plans/

# Build. Anchored: a bare `noergler` matches any path component of that name at
# any depth, which would silently swallow a nested one.
/backend/noergler
fakes
/bin/

# IDEs
.vscode/
.idea/
*.iml
*.swp
*~

# Agent tooling
.claude/
.agents/
.cursor/
.aider*
.codex/
.zed/
.windsurf/

# macOS
.DS_Store

# IntelliJ HTTP client: host, team secret and admin token, filled in locally (template: .example)
http/http-client.env.json

# ship:begin (owned by ship init; the repo's own lines go above the begin marker)
# What the gate and the UI build write into the tree.
coverage/ui/
ui/node_modules/
ui/*.tsbuildinfo
# The UI build the Go binary embeds; .gitkeep stays tracked so go:embed's dir exists in a fresh clone.
backend/web/dist/*
!backend/web/dist/.gitkeep
# ship:end
